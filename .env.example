# Server Configuration
PORT=3000
NODE_ENV=development
APP_PREFIX=v1

# GT02A TCP Socket Listener (Port yang dituju oleh GT02A)
GT02A_TCP_PORT=7018

# Dyegoo Cloud Bridge (Auto-Sync dari Server Bawaan GT02A/XY03D Tanpa SMS & Tanpa Tunnel)
DYEGOO_ENABLED=true
DYEGOO_DEVICE_SN=28044909404
DYEGOO_DEVICE_IMEI=355228044909404
DYEGOO_PASSWORD=your_device_password
DYEGOO_DEVICE_ID=566032
DYEGOO_USER_ID=574323
DYEGOO_POLL_INTERVAL_MS=10000

# MongoDB Database URI (Local / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/tracking_gajah_db

# RabbitMQ Broker URI (Opsional)
RABBITMQ_URI=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_QUEUE_GPS=gps_data_queue
RABBITMQ_QUEUE_HB=heartbeat_queue

# Authentication & JWT Security
JWT_SECRET=ChangeThisJwtSecretInProduction
JWT_EXPIRATION=1d
REFRESH_TOKEN_SECRET=ChangeThisRefreshTokenSecretInProduction
REFRESH_TOKEN_EXPIRATION=7d

# Swagger API Docs
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeThisPassword
